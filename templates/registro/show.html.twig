{% extends 'base.html.twig' %}

{% block title %}Registro{% endblock %}

{% block body %}
    <div class="container mt-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_registro_index') }}">Registros</a></li>
                <li class="breadcrumb-item active" aria-current="page"> {{  registro.slug }} </li>
            </ol>
        </nav>
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-dark shadow-sm mt-3 h-100">
                    <div class="card-header bg-dark text-white">
                        <i class="bi bi-person-vcard-fill me-2"></i>
                        Información personal
                    </div>

                    <div class="card-body">

                        <h4 class="card-title mb-3">
                            {{ registro.nombre }} {{ registro.paterno }} {{ registro.materno }}
                        </h4>

                        {% set edad = date().diff(date(registro.nacimiento)).y %}

                        <ul class="list-group list-group-flush">

                            <li class="list-group-item">
                                <i class="bi bi-envelope-fill text-primary me-2"></i>
                                <a href="mailto:{{ registro.mail }}" class="text-decoration-none">
                                    {{ registro.mail }}
                                </a>
                            </li>

                            <li class="list-group-item">
                                <i class="bi bi-calendar-event-fill text-primary me-2"></i>
                                <strong>Fecha de nacimiento:</strong>
                                {{ registro.nacimiento|format_date('long', locale='es') }}
                            </li>

                            <li class="list-group-item d-flex justify-content-between flex-wrap">
                    <span>
                        <i class="bi bi-person-fill text-primary me-2"></i>
                        <strong>Sexo:</strong> {{ registro.sexo }}
                    </span>

                                <span class="badge bg-secondary">
                        {{ edad }} años
                    </span>
                            </li>

                            <li class="list-group-item">
                                <i class="bi bi-telephone-fill text-primary me-2"></i>
                                <strong>Teléfono:</strong>
                                <a href="tel:{{ registro.telefono }}" class="text-decoration-none">
                                    {{ registro.telefono }}
                                </a>
                            </li>

                            <li class="list-group-item">
                                <i class="bi bi-person-heart text-danger me-2"></i>
                                <strong>Contacto de emergencia:</strong><br>

                                <span>{{ registro.contacto }}</span><br>

                                <a href="tel:{{ registro.contactotel }}" class="text-decoration-none">
                                    {{ registro.contactotel }}
                                </a>
                            </li>

                            <li class="list-group-item">
                                <strong>Credencial:</strong>

                                {% if registro.credencialName %}
                                    <a href="{{ vich_uploader_asset(registro, 'credencialFile') }}" target="_blank"
                                       class="btn btn-sm btn-outline-primary ms-2">
                                        <i class="fa-regular fa-file-pdf"></i>
                                        Ver credencial
                                    </a>
                                {% else %}
                                    <span class="badge bg-warning text-dark ms-2">
                            Sin credencial
                        </span>
                                {% endif %}
                            </li>

                        </ul>

                    </div>
                </div>
            </div>
            </div>
        <div class="col-lg-8">
            <div class="card border-dark shadow-sm mt-3">

                <div class="card-header bg-dark text-white">
                    <i class="bi bi-mortarboard-fill me-2"></i>
                    Información académica
                </div>

                <div class="card-body">

                    <h4 class="card-title mb-4">
                        {{ registro.procedencia }}
                    </h4>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <small class="text-muted">Carrera</small>
                            <div>{{ registro.carrera }}</div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Programa</small>
                            <div>{{ registro.programa }}</div>
                        </div>

                        <div class="col-md-4">
                            <small class="text-muted">Semestre/Cuatrimestre</small><br>
                            <span class="badge bg-secondary">{{ registro.semestre }}</span>
                        </div>

                        <div class="col-md-4">
                            <small class="text-muted">Avance del programa</small><br>
                            <span class="badge bg-primary">{{ registro.porcentaje }}%</span>
                        </div>

                        <div class="col-md-4">
                            <small class="text-muted">Avance de tesis</small><br>
                            <span class="badge bg-info text-dark">{{ registro.porcentajetesis }}%</span>
                        </div>

                        <div class="col-md-4">
                            <small class="text-muted">Promedio</small><br>
                            <span class="badge bg-success">{{ registro.promedio }}</span>
                        </div>

                    </div>

                    <hr>

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-file-earmark-pdf-fill me-2"></i>
                        Documentación
                    </h6>

                    {% if registro.caliName %}
                        <a href="{{ vich_uploader_asset(registro, 'caliFile') }}"
                           target="_blank"
                           class="btn btn-outline-primary btn-sm me-2 mb-2">
                            <i class="fa-regular fa-file-pdf"></i>
                            Memorándum / Constancia
                        </a>
                    {% else %}
                        <span class="badge bg-warning text-dark">
                    Sin memorándum o constancia
                </span>
                    {% endif %}

                    {% if registro.cartaName %}
                        <a href="{{ vich_uploader_asset(registro, 'cartaFile') }}"
                           target="_blank"
                           class="btn btn-outline-primary btn-sm mb-2">
                            <i class="fa-regular fa-file-pdf"></i>
                            Carta de recomendación
                        </a>
                    {% endif %}

                    <hr>

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-person-check-fill me-2"></i>
                        Profesor que recomienda
                    </h6>

                    <ul class="list-group list-group-flush mb-3">

                        <li class="list-group-item">
                            <strong>{{ registro.profesor }}</strong>
                        </li>

                        <li class="list-group-item">
                            <i class="bi bi-envelope me-2"></i>

                            <a href="mailto:{{ registro.mailprofesor }}">
                                {{ registro.mailprofesor }}
                            </a>
                        </li>

                        <li class="list-group-item">
                            <i class="bi bi-building me-2"></i>
                            {{ registro.univprofesor|title }}
                        </li>

                    </ul>

                    {% if registro.recomendacion %}
                        <div class="alert alert-light border">
                            <h6 class="mb-2">
                                <i class="bi bi-chat-left-quote"></i>
                                Recomendación
                            </h6>

                            {{ registro.recomendacion|nl2br }}
                        </div>

                    {% elseif not registro.cartaName %}

                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            No se adjuntó carta ni texto de recomendación.
                        </div>

                    {% endif %}

                </div>

            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-dark shadow-sm mt-3">

                <div class="card-header bg-dark text-white">
                    <i class="bi bi-calendar-event-fill me-2"></i>
                    {{ evento }}
                </div>

                <div class="card-body">

                    <div class="mb-4">
                        <h6 class="text-muted mb-2">Beca solicitada</h6>

                        {% if registro.beca %}
                            <span class="badge bg-primary fs-6">
                        {{ registro.beca }}
                    </span>
                        {% else %}
                            <span class="badge bg-secondary">
                        No requiere beca
                    </span>
                        {% endif %}
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted">
                            <i class="bi bi-cup-hot-fill me-2"></i>
                            Restricciones de alimentación
                        </h6>

                        {% if registro.restricciones %}
                            <div class="alert alert-light border mb-0">
                                {{ registro.restricciones|nl2br }}
                            </div>
                        {% else %}
                            <span class="text-muted">Sin restricciones reportadas.</span>
                        {% endif %}
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted">
                            <i class="bi bi-chat-left-text-fill me-2"></i>
                            Motivos para asistir
                        </h6>

                        <div class="alert alert-light border mb-0">
                            {{ registro.razones|nl2br }}
                        </div>
                    </div>

                    <hr>

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-clipboard-check-fill me-2"></i>
                        Estado de la solicitud
                    </h6>

                    <div class="d-flex flex-wrap gap-2">

                        {% if registro.aceptado %}
                            <span class="badge bg-success fs-6">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Participante aceptado
                    </span>
                        {% else %}
                            <span class="badge bg-danger fs-6">
                        <i class="bi bi-x-circle-fill me-1"></i>
                        Participante no aceptado
                    </span>
                        {% endif %}

                        {% if registro.confirmado %}
                            <span class="badge bg-success fs-6">
                        <i class="bi bi-person-check-fill me-1"></i>
                        Participante confirmado
                    </span>
                        {% else %}
                            <span class="badge bg-warning text-dark fs-6">
                        <i class="bi bi-hourglass-split me-1"></i>
                        Participante no confirmado
                    </span>
                        {% endif %}

                    </div>

                </div>

            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-dark shadow-sm mt-3">

                <div class="card-header bg-dark text-white">
                    <i class="bi bi-clipboard-data-fill me-2"></i>
                    Información de control
                </div>

                <div class="card-body">

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <small class="text-muted d-block">Fecha de registro</small>
                            <span class="badge bg-light text-dark border">
                        <i class="bi bi-calendar-plus me-1"></i>
                        {{ registro.created|format_date('long', locale='es') }}
                    </span>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Última modificación</small>
                            <span class="badge bg-light text-dark border">
                        <i class="bi bi-pencil-square me-1"></i>
                        {{ registro.modified|format_date('long', locale='es') }}
                    </span>
                        </div>

                    </div>

                    <hr>

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-chat-left-text-fill me-2"></i>
                        Comentarios del evaluador
                    </h6>

                    {% if registro.comentarios %}
                        <div class="alert alert-light border">
                            {{ registro.comentarios|nl2br }}
                        </div>
                    {% else %}
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            No hay comentarios registrados.
                        </div>
                    {% endif %}

                    <div class="d-flex justify-content-end">

                        <div {{ stimulus_controller('modal-form', {
                            formUrl: path('app_registro_evaluacion', {'slug': registro.slug})
                        }) }}>

                            <button
                                    type="button"
                                    class="btn btn-primary"
                                    data-action="modal-form#openModal">
                                <i class="bi bi-pencil-square me-2"></i>
                                Evaluar registro
                            </button>

                            {{ include('registro/_modal.html.twig', {
                                modalTitle: 'Evaluar registro'
                            }) }}

                        </div>

                    </div>

                </div>

            </div>
        </div>
        </div>
    </div>
{% endblock %}
