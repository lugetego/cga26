{% extends 'base.html.twig' %}

{% block title %}Registro{% endblock %}

{% block body %}
    <div class="container mt-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_registro_index') }}">Registros</a></li>
                <li class="breadcrumb-item active" aria-current="page"> {{  registro.slug }} </li>
            </ol>
        </nav>
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mt-3">

                    <div class="card-header bg-dark text-white">
                        <i class="bi bi-person-vcard-fill me-2"></i>
                        Información personal
                    </div>

                    <div class="card-body">

                        {% set edad = date().diff(date(registro.nacimiento)).y %}

                        <div class="d-flex justify-content-between align-items-start mb-4">

                            <div>
                                <h3 class="mb-1">
                                    {{ registro.nombre }}
                                    {{ registro.paterno }}
                                    {{ registro.materno }}
                                </h3>

                                <span class="text-muted">
                        {{ registro.mail }}
                    </span>
                            </div>

                            {% if registro.credencialName %}
                                <a href="{{ vich_uploader_asset(registro,'credencialFile') }}"
                                   target="_blank"
                                   class="btn btn-outline-primary">
                                    <i class="fa-regular fa-file-pdf"></i>
                                    Credencial
                                </a>
                            {% else %}
                                <span class="badge bg-warning text-dark">
                        Sin credencial
                    </span>
                            {% endif %}

                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label text-muted mb-1">
                                    <i class="bi bi-envelope"></i>
                                    Correo electrónico
                                </label>

                                <div>
                                    <a href="mailto:{{ registro.mail }}">
                                        {{ registro.mail }}
                                    </a>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-muted mb-1">
                                    <i class="bi bi-telephone"></i>
                                    Teléfono
                                </label>

                                <div>
                                    <a href="tel:{{ registro.telefono }}">
                                        {{ registro.telefono }}
                                    </a>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-muted mb-1">
                                    Fecha de nacimiento
                                </label>

                                <div>
                                    {{ registro.nacimiento|format_date('long', locale='es') }}
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-muted mb-1">
                                    Sexo
                                </label>

                                <div>
                                    {{ registro.sexo }}
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-muted mb-1">
                                    Edad
                                </label>

                                <div>
                        <span class="badge bg-secondary">
                            {{ edad }} años
                        </span>
                                </div>
                            </div>

                        </div>

                        <hr>

                        <div class="card bg-light border-0">

                            <div class="card-body">

                                <h6 class="card-title">
                                    <i class="bi bi-person-heart text-danger"></i>
                                    Contacto de emergencia
                                </h6>

                                <strong>{{ registro.contacto }}</strong>

                                <br>

                                <a href="tel:{{ registro.contactotel }}">
                                    {{ registro.contactotel }}
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mt-3">

                <div class="card-header bg-dark text-white">
                    <i class="bi bi-mortarboard-fill me-2"></i>
                    Información académica
                </div>

                <div class="card-body">

                    <h3 class="mb-1">{{ registro.procedencia }}</h3>
                    <p class="text-muted mb-4">
                        {{ registro.carrera }}
                        {% if registro.programa %}
                            · {{ registro.programa }}
                        {% endif %}
                    </p>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label class="form-label text-muted">
                                Semestre / Cuatrimestre
                            </label>

                            <div>
                        <span class="badge bg-secondary fs-6">
                            {{ registro.semestre }}
                        </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted">
                                Promedio
                            </label>

                            <div>
                        <span class="badge bg-success fs-6">
                            {{ registro.promedio }}
                        </span>
                            </div>
                        </div>

                        <div class="col-12">

                            <label class="form-label text-muted mb-1">
                                Avance del programa
                            </label>

                            <div class="progress" style="height:22px;">
                                <div
                                        class="progress-bar bg-primary"
                                        role="progressbar"
                                        style="width: {{ registro.porcentaje }}%;"
                                        aria-valuenow="{{ registro.porcentaje }}"
                                        aria-valuemin="0"
                                        aria-valuemax="100">

                                    {{ registro.porcentaje }}%

                                </div>
                            </div>

                        </div>

                        <div class="col-12">

                            <label class="form-label text-muted mb-1">
                                Avance de tesis
                            </label>

                            <div class="progress" style="height:22px;">
                                <div
                                        class="progress-bar bg-info text-dark"
                                        role="progressbar"
                                        style="width: {{ registro.porcentajetesis }}%;"
                                        aria-valuenow="{{ registro.porcentajetesis }}"
                                        aria-valuemin="0"
                                        aria-valuemax="100">

                                    {{ registro.porcentajetesis }}%

                                </div>
                            </div>

                        </div>

                    </div>

                    <hr>

                    <h5 class="mb-3">
                        <i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i>
                        Documentación
                    </h5>

                    <div class="d-flex flex-wrap gap-2">

                        {% if registro.caliName %}
                            <a href="{{ vich_uploader_asset(registro,'caliFile') }}"
                               target="_blank"
                               class="btn btn-outline-primary">
                                <i class="fa-regular fa-file-pdf me-1"></i>
                                Memorándum / Constancia
                            </a>
                        {% endif %}

                        {% if registro.cartaName %}
                            <a href="{{ vich_uploader_asset(registro,'cartaFile') }}"
                               target="_blank"
                               class="btn btn-outline-primary">
                                <i class="fa-regular fa-file-pdf me-1"></i>
                                Carta de recomendación
                            </a>
                        {% endif %}

                        {% if not registro.caliName and not registro.cartaName %}
                            <span class="badge bg-warning text-dark">
                        No hay documentos adjuntos
                    </span>
                        {% endif %}

                    </div>

                    <hr>

                    <h5 class="mb-3">
                        <i class="bi bi-person-check-fill me-2"></i>
                        Profesor que recomienda
                    </h5>

                    <div class="card bg-light border-0">

                        <div class="card-body">

                            <h6 class="mb-1">
                                {{ registro.profesor }}
                            </h6>

                            <div class="mb-2">
                                <a href="mailto:{{ registro.mailprofesor }}">
                                    {{ registro.mailprofesor }}
                                </a>
                            </div>

                            <div class="text-muted">
                                {{ registro.univprofesor|title }}
                            </div>

                        </div>

                    </div>

                    {% if registro.recomendacion %}

                        <div class="card border-0 bg-light mt-3">

                            <div class="card-body">

                                <h6>
                                    <i class="bi bi-chat-left-quote me-2"></i>
                                    Recomendación
                                </h6>

                                {{ registro.recomendacion|nl2br }}

                            </div>

                        </div>

                    {% elseif not registro.cartaName %}

                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            No se adjuntó carta de recomendación ni texto de recomendación.
                        </div>

                    {% endif %}

                </div>

            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mt-3">

                <div class="card-header bg-dark text-white">
                    <i class="bi bi-calendar-event-fill me-2"></i>
                    {{ evento }}
                </div>

                <div class="card-body">

                    <!-- Estado -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

                        <div>
                            <h4 class="mb-0">{{ evento }}</h4>
                            <small class="text-muted">
                                Estado de la solicitud
                            </small>
                        </div>

                        <div class="d-flex gap-2">

                            {% if registro.aceptado %}
                                <span class="badge bg-success fs-6">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Aceptado
                        </span>
                            {% else %}
                                <span class="badge bg-danger fs-6">
                            <i class="bi bi-x-circle-fill me-1"></i>
                            No aceptado
                        </span>
                            {% endif %}

                            {% if registro.confirmado %}
                                <span class="badge bg-primary fs-6">
                            <i class="bi bi-person-check-fill me-1"></i>
                            Confirmado
                        </span>
                            {% else %}
                                <span class="badge bg-warning text-dark fs-6">
                            <i class="bi bi-hourglass-split me-1"></i>
                            Pendiente
                        </span>
                            {% endif %}

                        </div>

                    </div>

                    <hr>

                    <!-- Información general -->

                    <div class="row g-4">

                        <div class="col-md-4">

                            <label class="form-label text-muted">
                                Beca solicitada
                            </label>

                            <div>

                                {% if registro.beca %}
                                    <span class="badge bg-primary fs-6">
                                {{ registro.beca }}
                            </span>
                                {% else %}
                                    <span class="text-muted">
                                No requiere beca
                            </span>
                                {% endif %}

                            </div>

                        </div>

                        <div class="col-md-8">

                            <label class="form-label text-muted">
                                Restricciones alimentarias
                            </label>

                            <div class="card bg-light border-0">

                                <div class="card-body py-2">

                                    {% if registro.restricciones %}
                                        {{ registro.restricciones|nl2br }}
                                    {% else %}
                                        <span class="text-muted">
                                    Sin restricciones registradas.
                                </span>
                                    {% endif %}

                                </div>

                            </div>

                        </div>

                    </div>

                    <hr>

                    <label class="form-label text-muted">
                        <i class="bi bi-chat-left-text me-1"></i>
                        Motivos para asistir
                    </label>

                    <div class="card bg-light border-0">

                        <div class="card-body">

                            {{ registro.razones|nl2br }}

                        </div>

                    </div>

                </div>

            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-dark shadow-sm mt-3">

                <div class="card-header bg-dark text-white">
                    <i class="bi bi-clipboard-data-fill me-2"></i>
                    Información de control
                </div>

                <div class="card-body">

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <small class="text-muted d-block">Fecha de registro</small>
                            <span class="badge bg-light text-dark border">
                        <i class="bi bi-calendar-plus me-1"></i>
                        {{ registro.created|format_date('long', locale='es') }}
                    </span>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Última modificación</small>
                            <span class="badge bg-light text-dark border">
                        <i class="bi bi-pencil-square me-1"></i>
                        {{ registro.modified|format_date('long', locale='es') }}
                    </span>
                        </div>

                    </div>

                    <hr>

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-chat-left-text-fill me-2"></i>
                        Comentarios del evaluador
                    </h6>

                    {% if registro.comentarios %}
                        <div class="alert alert-light border">
                            {{ registro.comentarios|nl2br }}
                        </div>
                    {% else %}
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            No hay comentarios registrados.
                        </div>
                    {% endif %}

                    <div class="d-flex justify-content-end">

                        <div {{ stimulus_controller('modal-form', {
                            formUrl: path('app_registro_evaluacion', {'slug': registro.slug})
                        }) }}>

                            <button
                                    type="button"
                                    class="btn btn-primary"
                                    data-action="modal-form#openModal">
                                <i class="bi bi-pencil-square me-2"></i>
                                Evaluar registro
                            </button>

                            {{ include('registro/_modal.html.twig', {
                                modalTitle: 'Evaluar registro'
                            }) }}

                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>
    </div>
{% endblock %}
